PORT=3333
NODE_ENV=development

# Supabase project
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Chave secreta somente do backend. Nunca use no frontend.
SUPABASE_SECRET_KEY=
# Compatibilidade opcional com projetos que ainda usam a chave JWT legada:
# SUPABASE_SERVICE_ROLE_KEY=
PRODUCT_IMAGE_BUCKET=product-images

# CORS
FRONTEND_ORIGIN=http://127.0.0.1:5500,http://localhost:5173

# Store slug used by the first deployment
DEFAULT_STORE_SLUG=atrevida-gourmet
TRUST_PROXY=false
SERVE_STATIC=false
